{
  "Comment": "Crawl today with weekday retries and late weekend retries after the Mezamashi update window",
  "StartAt": "CheckDryRun",
  "States": {
    "CheckDryRun": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.dryRun",
          "BooleanEquals": true,
          "Next": "FirstCrawl"
        }
      ],
      "Default": "SetDryRunFalse"
    },
    "SetDryRunFalse": {
      "Type": "Pass",
      "Result": false,
      "ResultPath": "$.dryRun",
      "Next": "FirstCrawl"
    },
    "FirstCrawl": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${CrawlerFunctionArn}",
        "Payload.$": "$"
      },
      "ResultPath": "$.crawlResult",
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "States.TaskFailed"
          ],
          "IntervalSeconds": 10,
          "BackoffRate": 2,
          "MaxAttempts": 3
        }
      ],
      "Next": "FirstResult"
    },
    "FirstResult": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.crawlResult.Payload.status",
          "StringEquals": "stale",
          "Next": "WaitBeforeSecondCrawl"
        },
        {
          "Variable": "$.crawlResult.Payload.status",
          "StringEquals": "partial",
          "Next": "WaitBeforeSecondCrawl"
        }
      ],
      "Default": "DispatchDueNotifications"
    },
    "WaitBeforeSecondCrawl": {
      "Type": "Wait",
      "Seconds": 1200,
      "Next": "SecondCrawl"
    },
    "SecondCrawl": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${CrawlerFunctionArn}",
        "Payload.$": "$"
      },
      "ResultPath": "$.crawlResult",
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "States.TaskFailed"
          ],
          "IntervalSeconds": 10,
          "BackoffRate": 2,
          "MaxAttempts": 3
        }
      ],
      "Next": "SecondResult"
    },
    "SecondResult": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.crawlResult.Payload.status",
          "StringEquals": "stale",
          "Next": "WaitBeforeThirdCrawl"
        },
        {
          "Variable": "$.crawlResult.Payload.status",
          "StringEquals": "partial",
          "Next": "WaitBeforeThirdCrawl"
        }
      ],
      "Default": "DispatchDueNotifications"
    },
    "WaitBeforeThirdCrawl": {
      "Type": "Wait",
      "Seconds": 1200,
      "Next": "ThirdCrawl"
    },
    "ThirdCrawl": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${CrawlerFunctionArn}",
        "Payload.$": "$"
      },
      "ResultPath": "$.crawlResult",
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "States.TaskFailed"
          ],
          "IntervalSeconds": 10,
          "BackoffRate": 2,
          "MaxAttempts": 3
        }
      ],
      "Next": "ThirdResult"
    },
    "ThirdResult": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.crawlResult.Payload.status",
          "StringEquals": "stale",
          "Next": "CheckWeekendFallbackWindow"
        },
        {
          "Variable": "$.crawlResult.Payload.status",
          "StringEquals": "partial",
          "Next": "CheckWeekendFallbackWindow"
        }
      ],
      "Default": "DispatchDueNotifications"
    },
    "NoFreshData": {
      "Type": "Fail",
      "Error": "NoFreshHoroscopeData",
      "Cause": "No complete translated horoscope data after the configured weekday/weekend retries"
    },
    "DispatchDueNotifications": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${NotificationDispatcherFunctionArn}",
        "Payload": {
          "dryRun.$": "$.dryRun"
        }
      },
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException"
          ],
          "IntervalSeconds": 10,
          "BackoffRate": 2,
          "MaxAttempts": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "Next": "Succeeded"
        }
      ],
      "Next": "Succeeded"
    },
    "Succeeded": {
      "Type": "Succeed"
    },
    "CheckWeekendFallbackWindow": {
      "Type": "Choice",
      "Choices": [
        {
          "Or": [
            {
              "Variable": "$.crawlResult.Payload.source",
              "StringEquals": "gogo"
            },
            {
              "Variable": "$.crawlResult.Payload.source",
              "StringEquals": "mezamashi"
            }
          ],
          "Next": "WaitForWeekendUpdate"
        }
      ],
      "Default": "NoFreshData"
    },
    "WaitForWeekendUpdate": {
      "Type": "Wait",
      "Seconds": 3600,
      "Next": "WeekendCrawl"
    },
    "WeekendCrawl": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${CrawlerFunctionArn}",
        "Payload.$": "$"
      },
      "ResultPath": "$.crawlResult",
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "States.TaskFailed"
          ],
          "IntervalSeconds": 10,
          "BackoffRate": 2,
          "MaxAttempts": 3
        }
      ],
      "Next": "WeekendResult"
    },
    "WeekendResult": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.crawlResult.Payload.status",
          "StringEquals": "stale",
          "Next": "WaitBeforeWeekendRetry"
        },
        {
          "Variable": "$.crawlResult.Payload.status",
          "StringEquals": "partial",
          "Next": "WaitBeforeWeekendRetry"
        }
      ],
      "Default": "DispatchDueNotifications"
    },
    "WaitBeforeWeekendRetry": {
      "Type": "Wait",
      "Seconds": 1200,
      "Next": "WeekendRetryCrawl"
    },
    "WeekendRetryCrawl": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${CrawlerFunctionArn}",
        "Payload.$": "$"
      },
      "ResultPath": "$.crawlResult",
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "States.TaskFailed"
          ],
          "IntervalSeconds": 10,
          "BackoffRate": 2,
          "MaxAttempts": 3
        }
      ],
      "Next": "WeekendRetryResult"
    },
    "WeekendRetryResult": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.crawlResult.Payload.status",
          "StringEquals": "stale",
          "Next": "NoFreshData"
        },
        {
          "Variable": "$.crawlResult.Payload.status",
          "StringEquals": "partial",
          "Next": "NoFreshData"
        }
      ],
      "Default": "DispatchDueNotifications"
    }
  }
}
