{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ESNext", "DOM"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["deno"],
    "typeRoots": ["../../backend/node_modules/@types"],
    "paths": {
      "npm:@supabase/supabase-js@2": ["../../backend/node_modules/@supabase/supabase-js"]
    }
  },
  "include": ["**/*.ts"]
}
