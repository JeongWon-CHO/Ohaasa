{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "APP_VARIANT": "development"
      },
      "node": "22.23.4"
    },
    "preview": {
      "developmentClient": false,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "APP_VARIANT": "preview"
      },
      "node": "22.23.4"
    },
    "verify": {
      "developmentClient": false,
      "distribution": "internal",
      "android": {
        "buildType": "apk",
        "credentialsSource": "remote"
      },
      "env": {
        "APP_VARIANT": "preview"
      },
      "node": "22.23.4"
    },
    "production-apk": {
      "extends": "production",
      "distribution": "internal",
      "environment": "production",
      "android": {
        "buildType": "apk"
      },
      "autoIncrement": false
    },
    "production": {
      "developmentClient": false,
      "distribution": "store",
      "android": {
        "buildType": "app-bundle"
      },
      "autoIncrement": true,
      "env": {
        "APP_VARIANT": "production"
      },
      "node": "22.23.4"
    }
  }
}
